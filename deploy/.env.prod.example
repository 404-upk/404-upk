# Настройки боевого сервера. Скопируйте в .env в корне проекта и заполните.
# Если что-то опасное осталось по умолчанию, приложение не запустится и напишет, что исправить.

DOMAIN=upk.example.ru
PUBLIC_URL=https://upk.example.ru
POSTGRES_PASSWORD=замените-на-длинный-случайный-пароль

SEED_DEMO=false
SHOW_DEMO_LOGINS=false
# Демо-аккаунтов на сервере нет. Первого администратора создаёт команда из README:
# docker compose ... exec app python -m app.create_admin --login ... --name "..."

GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_VISION_MODEL=GigaChat-Pro
GIGACHAT_CA_BUNDLE=certs/russian_trusted_root_ca.cer
GIGACHAT_VERIFY_SSL=true
AI_MIN_CONFIDENCE=0.5

TELEGRAM_BOT_TOKEN=
TELEGRAM_STAFF_CHAT_ID=

SESSION_TTL_HOURS=12
MAX_UPLOAD_MB=8
AI_LOG_RETENTION_DAYS=90
CONTACT_RETENTION_DAYS=90
