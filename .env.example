# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.

# development или production. В production сервер не запустится с демо-паролями, без HTTPS и без PostgreSQL.
APP_ENV=development

# Адрес, по которому сайт открывается снаружи. Из него собираются ссылки в QR-кодах.
PUBLIC_URL=http://localhost:8000

# GigaChat API: ключ авторизации из личного кабинета developers.sber.ru (Authorization key).
# Пока ключ пустой, ИИ работает в демо-режиме на встроенных правилах и базе знаний.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_VISION_MODEL=GigaChat-Pro
# Корневой сертификат Минцифры, см. certs/README.md
GIGACHAT_CA_BUNDLE=certs/russian_trusted_root_ca.cer
# Если сертификата нет, проверку можно временно выключить (не для боевой установки)
GIGACHAT_VERIFY_SSL=true
# Ниже этой уверенности вопрос передаётся человеку
AI_MIN_CONFIDENCE=0.5

# Telegram-бот (необязательно): токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Чат или группа сотрудников для новых заявок. Если пусто, пишем лично сотрудникам, подключившим бота.
TELEGRAM_STAFF_CHAT_ID=

# Демо-данные и пароли демо-аккаунтов
SEED_DEMO=true
SHOW_DEMO_LOGINS=true
DEMO_ADMIN_PASSWORD=upk-admin-2026
DEMO_STAFF_PASSWORD=upk-staff-2026
DEMO_EXECUTOR_PASSWORD=upk-exec-2026

# Прочее
SESSION_TTL_HOURS=12
MAX_UPLOAD_MB=8
# true, если сервер стоит за nginx или другим прокси
TRUST_PROXY=false

# База данных. Пусто: SQLite в папке data (для разработки). На сервере: postgresql://пользователь:пароль@хост:5432/upk
DATABASE_URL=

# Документация API на /api/docs. По умолчанию включена везде, кроме production.
# ENABLE_DOCS=true

# Сколько дней хранить тексты обращений к ИИ и контакты после закрытия заявки (0: не удалять)
AI_LOG_RETENTION_DAYS=90
CONTACT_RETENTION_DAYS=90

# Лимиты на один адрес. В зале или Wi-Fi колледжа все выглядят одним адресом, на показ их можно поднять
RATE_TICKETS_PER_10MIN=30
RATE_JOINS_PER_10MIN=30
RATE_ASSISTANT_PER_5MIN=60
RATE_TRACK_PER_5MIN=300
RATE_LOOKUP_PER_5MIN=300
# Сколько запросов в минуту уходит в GigaChat со всех адресов вместе, сверх этого отвечают правила
MODEL_REQUESTS_PER_MINUTE=60
# Какие демо-логины показывать на странице входа. Администратора показывать не стоит
DEMO_LOGINS_SHOWN=upk,electric
# Местное время для выгрузки, фильтров и статистики
UTC_OFFSET_HOURS=3
# Через сколько дней после закрытия удалять фото, описание и комментарии заявки, 0 значит не удалять
TICKET_RETENTION_DAYS=365
